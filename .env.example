# Copy to .env and fill in. .env is git-ignored; this file is committed.

# --- Agents (npm run gather / interpret / author / link / review / extract / pipeline) ---
ANTHROPIC_API_KEY=
# Defaults shown; uncomment to override. These apply to every agent.
# AGENT_MODEL=claude-sonnet-5-5      # or claude-opus-5-5 for the strongest reasoning (about 2x the cost)
# AGENT_EFFORT=high                  # low | medium | high | xhigh | max
# AGENT_FALLBACK=default             # default: retry safety-classifier refusals on Anthropic's recommended model; off: fail instead
# AGENT_MAX_TURNS=60
# AGENT_MAX_USD=5                    # hard stop on estimated model spend per run
# AGENT_MAX_WEB_SEARCHES=10
# HARVEST_MODEL=claude-haiku-5-5     # extracts events from documents; cheapest model by design

# --- Embeddings for the graph's vector indexes ---
OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=512           # changing this requires recreating the vector indexes (see kg/README.md)

# --- Knowledge graph (npm run kg:up / kg:migrate / kg) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
NEO4J_PASSWORD=
