# Copy to .env and fill in. .env is git-ignored; this file is committed.

# --- Fact-checker agent (npm run review) ---
ANTHROPIC_API_KEY=
# Defaults shown; uncomment to override.
# FACT_CHECKER_MODEL=claude-sonnet-5-5   # or claude-opus-5-5 for the strongest reviewer (about 2x the cost)
# FACT_CHECKER_EFFORT=high            # low | medium | high | xhigh | max
# FACT_CHECKER_FALLBACK=default       # default: retry safety-classifier refusals on Anthropic's recommended model; off: fail instead
# FACT_CHECKER_MAX_TURNS=60
# FACT_CHECKER_MAX_USD=5              # hard stop on estimated model spend per review
# FACT_CHECKER_MAX_WEB_SEARCHES=10

# Where reviews read content from and write results to: files (content/) or graph (Neo4j)
# REVIEW_STORE=files

# --- Knowledge graph (npm run kg:up / kg:migrate / kg:import) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
NEO4J_PASSWORD=
