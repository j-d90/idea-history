{
  "name": "history-of-ideas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc && vite build",
    "preview": "vite preview",
    "validate": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/validate.ts",
    "typecheck": "tsc",
    "review-hash": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/review-hash.ts",
    "pdftext": "node --disable-warning=ExperimentalWarning scripts/pdftext.ts",
    "check-tools": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/check-tools.ts",
    "review": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env agents/fact-checker/cli.ts",
    "kg:up": "node --disable-warning=ExperimentalWarning kg/src/compose.ts up",
    "kg:down": "node --disable-warning=ExperimentalWarning kg/src/compose.ts down",
    "kg:migrate": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env kg/src/migrate.ts",
    "test": "node --disable-warning=ExperimentalWarning --test agents/test/*.test.ts kg/test/*.test.ts",
    "extract": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env agents/extractor/cli.ts",
    "link": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env agents/linker/cli.ts",
    "gather": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env agents/gatherer/cli.ts",
    "interpret": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env agents/interpreter/cli.ts",
    "author": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env agents/author/cli.ts",
    "pipeline": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env agents/pipeline/cli.ts",
    "kg": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env kg/src/cli.ts"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "markdown-it": "^14.3.3",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "neo4j-driver": "^6.2.0",
    "openai": "^7.39.0"
  }
}
