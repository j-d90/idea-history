{
  "name": "history-of-ideas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc && vite build",
    "preview": "vite preview",
    "validate": "node --disable-warning=ExperimentalWarning scripts/validate.ts",
    "typecheck": "tsc",
    "review-hash": "node --disable-warning=ExperimentalWarning scripts/review-hash.ts",
    "pdftext": "node --disable-warning=ExperimentalWarning scripts/pdftext.ts",
    "review": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env agent/src/cli.ts",
    "kg:up": "node --disable-warning=ExperimentalWarning kg/src/compose.ts up",
    "kg:down": "node --disable-warning=ExperimentalWarning kg/src/compose.ts down",
    "kg:migrate": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env kg/src/migrate.ts",
    "kg:import": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env kg/src/import.ts",
    "test": "node --disable-warning=ExperimentalWarning --test agent/test/*.test.ts kg/test/*.test.ts"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "markdown-it": "^14.3.3",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "neo4j-driver": "^6.2.0"
  }
}
